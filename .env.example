# Backend Environment Variables Template
# Copy this file to .env and fill in the actual values
# DO NOT commit .env with real secrets to Git

# ===========================
# AWS RDS Database Configuration
# ===========================
# Separate database URLs for each microservice (same RDS instance, different databases)
FONDOS_DB_URL=jdbc:mysql://bancocloud-rds.c4w9fmcrztfs.us-east-1.rds.amazonaws.com:3306/fondos_db
INVERSIONES_DB_URL=jdbc:mysql://bancocloud-rds.c4w9fmcrztfs.us-east-1.rds.amazonaws.com:3306/inversiones_db
USUARIOS_DB_URL=jdbc:mysql://bancocloud-rds.c4w9fmcrztfs.us-east-1.rds.amazonaws.com:3306/usuarios_db
DB_USERNAME=admin
DB_PASSWORD=your_secure_password_here

# ===========================
# AWS Cognito Configuration
# ===========================
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_3rNV181z7

# ===========================
# Microservices Internal URLs
# ===========================
# For local development (localhost), for Docker use service names
FONDOS_SERVICE_URL=http://localhost:8081
INVERSIONES_SERVICE_URL=http://localhost:8082
USUARIOS_SERVICE_URL=http://localhost:8083

# ===========================
# CORS Configuration (BFF)
# ===========================
# Comma-separated list of allowed origins
# Include: localhost:5173 (Vite dev), localhost:3000 (React dev), localhost (Nginx in Docker)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# ===========================
# Application Environment
# ===========================
SPRING_PROFILES_ACTIVE=dev
