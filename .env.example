# Backend Environment Variables Template
# Copy this file to .env and fill in the actual values
# DO NOT commit .env with real secrets to Git

# ===========================
# AWS RDS Database Configuration
# ===========================
# Separate database URLs for each microservice (same RDS instance, different databases)
USUARIOS_DB_URL=jdbc:mysql://<rds-endpoint>:3306/usuarios_db
FONDOS_DB_URL=jdbc:mysql://<rds-endpoint>:3306/fondos_db
INVERSIONES_DB_URL=jdbc:mysql://<rds-endpoint>:3306/inversiones_db
DB_USERNAME=your_db_user
DB_PASSWORD=your_secure_password_here

# ===========================
# AWS Cognito Configuration
# ===========================
# Issuer: https://cognito-idp.<region>.amazonaws.com/<user-pool-id>
COGNITO_ISSUER=https://cognito-idp.us-east-1.amazonaws.com/us-east-1_XXXXXXXXX
# App Client ID (public client, no secret). The BFF rejects tokens issued for other clients.
COGNITO_CLIENT_ID=your_app_client_id
# Optional. Only for servers without internet access (e.g. a private EC2 without NAT):
# the User Pool public keys, so the BFF can verify tokens without reaching Cognito.
# Value: one line with the JSON from <COGNITO_ISSUER>/.well-known/jwks.json
# Leave empty to download them from Cognito (default).
COGNITO_JWKS=

# ===========================
# RabbitMQ Configuration
# ===========================
# Docker Compose: "rabbitmq" (the bundled container) or the EC2 host of the shared broker.
# Running the jars outside Docker: localhost, e.g. with
#   docker run -d --name rabbit -p 5672:5672 -p 15672:15672 rabbitmq:3-management
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
# The default "guest" user only works from localhost; use a dedicated user in Docker/EC2
RABBITMQ_USERNAME=your_rabbitmq_user
RABBITMQ_PASSWORD=your_rabbitmq_password
RABBITMQ_VHOST=/

# ===========================
# CORS Configuration (BFF)
# ===========================
# Comma-separated list of allowed origins
# Include: localhost:5173 (Vite dev), localhost:3000 (React dev), localhost (Nginx in Docker)
APP_CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# ===========================
# Frontend build (Docker Compose)
# ===========================
VITE_API_URL=http://localhost:8090/api/v1
VITE_COGNITO_USER_POOL_ID=us-east-1_XXXXXXXXX
VITE_COGNITO_USER_POOL_CLIENT_ID=your_app_client_id
VITE_AWS_REGION=us-east-1

# ===========================
# Application Environment
# ===========================
SPRING_PROFILES_ACTIVE=dev

# Internal service URLs are fixed in docker-compose.yml (Docker service names).
# To run the jars outside Docker they default to http://localhost:<port>.
